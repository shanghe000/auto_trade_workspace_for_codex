# 如果你希望本仓库里的脚本直接读取 OKX 凭证，可以使用这个文件。
# 如果你更倾向于沿用官方方式，也可以只维护 ~/.okx/config.toml。
# 复制为 config/okx.env 后再填写，真实值不要提交到仓库。

OKX_ENV=demo
OKX_USE_MCP=false

# 官方 CLI / 本仓库脚本兼容的凭证变量
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# 本仓库脚本也兼容下面这组旧别名，如已使用可继续保留
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# 可选账户元数据
OKX_ACCOUNT_MODE=isolated
OKX_SUBACCOUNT=

# MCP 路径，仅在你自己包装 MCP 启动参数时使用
OKX_MCP_SERVER=
OKX_MCP_PROFILE=
